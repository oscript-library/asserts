Перем Тип;

// Формирует строковое представление объекта-причины ошибки утверждения.
//
// Параметры:
//  Представление - Строка - формируемое представление объекта.
//  СтандартнаяОбработка - Булево - признак выполнения стандартной обработки; устанавливается в Ложь.
//
Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Представление = СтрШаблон("{Тип = %1}", Тип);
КонецПроцедуры

Тип = "Ошибка утверждения";
